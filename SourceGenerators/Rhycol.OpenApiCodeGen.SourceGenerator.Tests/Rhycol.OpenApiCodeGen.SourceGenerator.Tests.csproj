<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Rhycol.OpenApiCodeGen.SourceGenerator.Tests</AssemblyName>
    <RootNamespace>Rhycol.OpenApiCodeGen.SourceGenerator.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="../Rhycol.OpenApiCodeGen.SourceGenerator/Rhycol.OpenApiCodeGen.SourceGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!--
      Reference assemblies of .NET 8 (System.Text.Json 8.0). The tests run on net10, so this pack is
      only used to prove that the System.Text.Json output compiles against the 8.0 API surface (the
      minimum version of LibraryAvailability.MinimumSystemTextJsonVersion). Nothing from it is loaded.
    -->
    <PackageReference Include="Microsoft.NETCore.App.Ref" Version="8.0.0" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <!--
      Unity compiles against netstandard2.1 with the netstandard2.0 build of System.Text.Json 8 and
      Newtonsoft.Json 13. These reference-only packages let a test compile the generated code against that
      exact set (BCL members that net8 has but netstandard2.1 lacks are caught). Nothing is loaded.
    -->
    <PackageReference Include="NETStandard.Library.Ref" Version="2.1.0" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="System.Text.Encodings.Web" Version="8.0.0" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="System.Memory" Version="4.5.5" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="System.Buffers" Version="4.5.1" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestAssets/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Public API surface snapshot inputs. Specs and baselines are copied next to the test assembly
    so the tests do not depend on source paths. The project directory is exposed through
    assembly metadata only so the update mode (UPDATE_PUBLIC_API_BASELINE=1) can write back to
    the source tree.
  -->
  <ItemGroup>
    <None Include="ApiSurfaceSpecs/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ApiSurfaceBaselines/*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../BuildTools/UnityVerificationFixture/Specs/openapi.json"
          Link="ApiSurfaceSpecs/unity-fixture-openapi.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../BuildTools/UnityVerificationFixture/UnityWebRequestClient/Specs/openapi.json"
          Link="ApiSurfaceSpecs/unity-uwr-fixture-openapi.json" CopyToOutputDirectory="PreserveNewest" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ProjectDirectory</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NuGetPackageRoot</_Parameter1>
      <_Parameter2>$(NuGetPackageRoot)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Net8ReferenceDirectory</_Parameter1>
      <_Parameter2>$(PkgMicrosoft_NETCore_App_Ref)/ref/net8.0</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    The parity test intentionally executes the package's editor normalizers rather than a
    test-only reimplementation. Keep the parser glob linked so new parser files are compiled
    into this test assembly automatically; AssemblyInfo is excluded because its Unity-only
    InternalsVisibleTo declarations do not belong here.
  -->
  <ItemGroup>
    <Compile Include="../../Packages/OpenApiCodeGen.SourceGenerator/Editor/CanonicalSpecBundleWriter.cs"
             Link="LinkedProduction/CanonicalSpecBundleWriter.cs" />
    <Compile Include="../../Packages/OpenApiCodeGen.SourceGenerator/Editor/ExternalSpecGraphLoader.cs"
             Link="LinkedProduction/ExternalSpecGraphLoader.cs" />
    <Compile Include="../../Packages/OpenApiCodeGen.SourceGenerator/Editor/NormalizedSpecBundleConstants.cs"
             Link="LinkedProduction/NormalizedSpecBundleConstants.cs" />
    <Compile Include="../../Packages/OpenApiCodeGen.SourceGenerator/Editor/NormalizedSpecException.cs"
             Link="LinkedProduction/NormalizedSpecException.cs" />
    <Compile Include="../../Packages/OpenApiCodeGen.SourceGenerator/Editor/SafeGenerationException.cs"
             Link="LinkedProduction/SafeGenerationException.cs" />
    <Compile Include="../../Packages/OpenApiCodeGen.SourceGenerator/Editor/RawJsonNormalizer.cs"
             Link="LinkedProduction/RawJsonNormalizer.cs" />
    <Compile Include="../../Packages/OpenApiCodeGen.SourceGenerator/Editor/RawYamlNormalizer.cs"
             Link="LinkedProduction/RawYamlNormalizer.cs" />
    <Compile Include="../../Packages/OpenApiCodeGen.SourceGenerator/Editor/StrictJsonSpecParser.cs"
             Link="LinkedProduction/StrictJsonSpecParser.cs" />
    <Compile Include="../../Packages/OpenApiCodeGen.SourceGenerator/Editor/Parsing/*.cs"
             Exclude="../../Packages/OpenApiCodeGen.SourceGenerator/Editor/Parsing/AssemblyInfo.cs"
             Link="LinkedProduction/Parsing/%(Filename)%(Extension)" />
    <Compile Include="../../Packages/OpenApiCodeGen.SourceGenerator/Runtime/OpenApiDocumentFormat.cs"
             Link="LinkedProduction/OpenApiDocumentFormat.cs" />
    <Compile Include="../../Packages/OpenApiCodeGen.SourceGenerator/Runtime/OpenApiHttpTransport.cs"
             Link="LinkedProduction/OpenApiHttpTransport.cs" />
    <Compile Include="../../Packages/OpenApiCodeGen.SourceGenerator/Runtime/OpenApiJsonSerializer.cs"
             Link="LinkedProduction/OpenApiJsonSerializer.cs" />
    <Compile Include="../../Packages/OpenApiCodeGen.SourceGenerator/Runtime/OpenApiClientDefinitionAttribute.cs"
             Link="LinkedProduction/OpenApiClientDefinitionAttribute.cs" />
    <Compile Include="../../Packages/OpenApiCodeGen/Editor/Contracts/GenerationProviderContracts.cs"
             Link="LinkedProduction/GenerationProviderContracts.cs" />
    <Compile Include="../../Packages/OpenApiCodeGen/Editor/Contracts/GitHubAuthorizationPolicy.cs"
             Link="LinkedProduction/GitHubAuthorizationPolicy.cs" />
    <Compile Include="../../Packages/OpenApiCodeGen/Editor/ApplicationConstant.cs"
             Link="LinkedProduction/ApplicationConstant.cs" />
  </ItemGroup>
</Project>
