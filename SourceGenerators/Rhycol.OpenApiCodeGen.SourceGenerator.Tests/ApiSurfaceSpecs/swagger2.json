{
  "swagger": "2.0",
  "info": { "title": "Swagger 2.0 Petstore", "version": "1.0.0", "description": "P9: a Swagger 2.0 document normalized into OpenAPI 3.0." },
  "host": "petstore.example.test:8443",
  "basePath": "/v2",
  "schemes": [ "https", "http" ],
  "consumes": [ "application/json" ],
  "produces": [ "application/json" ],
  "tags": [ { "name": "pets", "description": "Everything about pets" } ],
  "externalDocs": { "url": "https://docs.example.test" },
  "securityDefinitions": {
    "basicAuth": { "type": "basic", "description": "HTTP basic" },
    "apiKeyAuth": { "type": "apiKey", "name": "X-Api-Key", "in": "header" },
    "petstoreAuth": {
      "type": "oauth2",
      "flow": "implicit",
      "authorizationUrl": "https://auth.example.test/authorize",
      "scopes": { "read:pets": "read pets", "write:pets": "modify pets" }
    }
  },
  "security": [ { "apiKeyAuth": [] } ],
  "parameters": {
    "limitParam": { "name": "limit", "in": "query", "type": "integer", "format": "int32", "minimum": 1, "maximum": 100, "description": "Page size" },
    "petBody": { "name": "body", "in": "body", "required": true, "description": "The pet", "schema": { "$ref": "#/definitions/Pet" } }
  },
  "responses": {
    "NotFound": { "description": "Not found", "schema": { "$ref": "#/definitions/Error" } }
  },
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "tags": [ "pets" ],
        "parameters": [
          { "$ref": "#/parameters/limitParam" },
          { "name": "tags", "in": "query", "type": "array", "items": { "type": "string" }, "collectionFormat": "multi" },
          { "name": "ids", "in": "query", "type": "array", "items": { "type": "integer", "format": "int64" } },
          { "name": "cols", "in": "query", "type": "array", "items": { "type": "string" }, "collectionFormat": "ssv" },
          { "name": "kinds", "in": "query", "type": "array", "items": { "type": "string" }, "collectionFormat": "pipes" },
          { "name": "X-Request-Id", "in": "header", "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "The pets",
            "schema": { "type": "array", "items": { "$ref": "#/definitions/Pet" } },
            "headers": { "X-Total-Count": { "type": "integer", "format": "int32", "description": "All pets" } }
          },
          "404": { "$ref": "#/responses/NotFound" }
        }
      },
      "post": {
        "operationId": "addPet",
        "parameters": [ { "$ref": "#/parameters/petBody" } ],
        "responses": {
          "201": { "description": "Created", "schema": { "$ref": "#/definitions/Pet" } }
        }
      }
    },
    "/pets/{petId}": {
      "parameters": [ { "name": "petId", "in": "path", "required": true, "type": "integer", "format": "int64" } ],
      "get": {
        "operationId": "getPet",
        "responses": {
          "200": { "description": "The pet", "schema": { "$ref": "#/definitions/Pet" } },
          "404": { "$ref": "#/responses/NotFound" }
        }
      },
      "put": {
        "operationId": "updatePet",
        "security": [ { "petstoreAuth": [ "write:pets" ] } ],
        "parameters": [
          { "name": "body", "in": "body", "required": true, "schema": { "type": "object", "additionalProperties": false, "required": [ "name" ], "properties": { "name": { "type": "string" }, "tag": { "$ref": "#/definitions/Tag", "x-nullable": true } } } }
        ],
        "responses": { "204": { "description": "Updated" } }
      },
      "delete": {
        "operationId": "deletePet",
        "security": [ { "basicAuth": [] } ],
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/pets/{petId}/photo": {
      "parameters": [ { "name": "petId", "in": "path", "required": true, "type": "integer", "format": "int64" } ],
      "get": {
        "operationId": "downloadPhoto",
        "produces": [ "image/png" ],
        "responses": { "200": { "description": "The photo", "schema": { "type": "file" } } }
      },
      "post": {
        "operationId": "uploadPhoto",
        "consumes": [ "multipart/form-data" ],
        "parameters": [
          { "name": "caption", "in": "formData", "type": "string", "required": true, "description": "Caption" },
          { "name": "photo", "in": "formData", "type": "file", "required": true }
        ],
        "responses": { "200": { "description": "Stored", "schema": { "$ref": "#/definitions/Tag" } } }
      }
    },
    "/login": {
      "post": {
        "operationId": "login",
        "consumes": [ "application/x-www-form-urlencoded" ],
        "parameters": [
          { "name": "username", "in": "formData", "type": "string", "required": true },
          { "name": "password", "in": "formData", "type": "string", "required": true },
          { "name": "scopes", "in": "formData", "type": "array", "items": { "type": "string" }, "collectionFormat": "csv" }
        ],
        "security": [],
        "responses": { "200": { "description": "Token", "schema": { "type": "string" } } }
      }
    }
  },
  "definitions": {
    "Pet": {
      "type": "object",
      "discriminator": "petType",
      "required": [ "name", "petType" ],
      "properties": {
        "id": { "type": "integer", "format": "int64", "readOnly": true },
        "name": { "type": "string", "example": "Rex" },
        "petType": { "type": "string" },
        "nickname": { "type": "string", "x-nullable": true }
      }
    },
    "Cat": {
      "allOf": [
        { "$ref": "#/definitions/Pet" },
        { "type": "object", "properties": { "huntingSkill": { "type": "string" } } }
      ]
    },
    "Dog": {
      "allOf": [
        { "$ref": "#/definitions/Pet" },
        { "type": "object", "properties": { "packSize": { "type": "integer", "minimum": 1 } } }
      ]
    },
    "Tag": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "id": { "type": "integer" }, "label": { "type": "string" } }
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "code", "message" ],
      "properties": { "code": { "type": "integer", "format": "int32" }, "message": { "type": "string" } }
    }
  }
}
